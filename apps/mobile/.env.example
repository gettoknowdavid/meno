MENO_API_URL=
# Include the API's socket path: the endpoint is `GET /ws` (routes/mod.rs). A bare
# host connects to `/`, which answers 401, so the client reports a failed
# handshake and never receives an event.
WEB_SOCKET_URL=
# The room server a release build joins. A development build ignores it and uses
# the LiveKit server in ops/docker-compose.yml instead — see docs/local-livekit.md.
MENO_LIVEKIT_URL=