# Copy to `.env` and fill in. Generated from the config struct in
# `apps/api/src/config.rs` — see that file for what each variable is used for.
#
# `Config::load` reports *every* missing or invalid variable at once, so the first
# run tells you everything you need to fix.

# ============ REQUIRED ============
# Without these the process refuses to start, and says which are missing.

JWT_SECRET=
JWT_REFRESH_SECRET=

DATABASE_URL=
REDIS_URL=

# Comma-separated. `master` hardcoded `yourdomain.com` here, so every real
# frontend request was CORS-rejected.
CORS_ORIGINS=

ENV=dev
PORT=8080
RUST_LOG=info,sqlx=warn

# ============ OPTIONAL / FEATURE-GATED ============
# Each integration is enabled by its flag. Enabled but incompletely configured is a
# startup error; disabled means it is never read.

# Live audio/video. All three are required together.
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# `LIVEKIT_HOST` is the pre-0.8 name for LIVEKIT_URL and is still read as a fallback.

# Push notifications. The service-account JSON is read *inline* — it was previously
# `FIREBASE_SERVICE_ACCOUNT_PATH`, a filesystem path that the variable name in this
# file never matched.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Transactional email. Enabled by setting SMTP_HOST; no separate flag.
# The transport is Brevo's HTTPS API (plan §3.6), not raw SMTP: SMTP_PASSWORD is the
# Brevo API key, SMTP_FROM is the bare sender address (no display name), and
# SMTP_PORT / SMTP_USER are accepted but unused by the API transport.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Point the mail API somewhere else. Leave unset in every real deployment.
# Set it locally to read outgoing mail in a browser instead of sending it:
#
#     node ops/mail-catcher.mjs            # http://127.0.0.1:1026
#     SMTP_ENDPOINT=http://127.0.0.1:1026
#
# The real adapter, the real rendering and the real request path all still run — only
# the hostname changes — so there is no provider account, no quota and no 401 to debug.
# An unparseable value fails the boot with a readable message rather than every send.
SMTP_ENDPOINT=

# Object storage. Enabled by STORAGE_ENABLED, or implicitly by setting
# STORAGE_ENDPOINT when the flag is absent.
STORAGE_ENABLED=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PUBLIC_URL=

# ============ GOOGLE OAUTH ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AUTH_URI=
GOOGLE_TOKEN_URI=

# ============ OPERATIONAL ============
# Escape hatch for running migrations separately from the web binary (plan §4.3).
# Off unless explicitly true.
SKIP_MIGRATIONS=false

# Static bearer token for `GET /metrics` (plan §7.5 — the endpoint must be private).
# Unset = the endpoint answers 404; set it and scrape with
# `Authorization: Bearer <value>`.
METRICS_TOKEN=

# ============ TOKEN LIFETIMES (seconds, optional) ============
ACCESS_TOKEN_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=604800